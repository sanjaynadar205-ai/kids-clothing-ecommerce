FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build

WORKDIR /src

COPY ["KidsWearStore.csproj", "./"]
RUN dotnet restore "KidsWearStore.csproj"

COPY . .
RUN dotnet publish "KidsWearStore.csproj" -c Release -o /app/publish --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final

WORKDIR /app

COPY --from=build /app/publish .

ENV ASPNETCORE_ENVIRONMENT=Production

CMD ["sh", "-c", "dotnet KidsWearStore.dll --urls http://0.0.0.0:${PORT:-8080}"]