@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="container py-5">
    <div class="mx-auto" style="max-width: 900px;">
        <div class="mb-5">
            <span class="text-uppercase small fw-semibold text-muted">CrisKidsWear</span>
            <h1 class="display-5 fw-bold mt-2">Privacy Policy</h1>
            <p class="text-muted mb-0">
                Your privacy matters to us. This policy explains how CrisKidsWear
                collects, uses, and protects your information.
            </p>
        </div>

        <div class="mb-4">
            <h2 class="h4 fw-bold">1. Information We Collect</h2>
            <p class="text-muted">
                When you create an account, place an order, contact us, or use
                our website, we may collect information such as your name,
                email address, phone number, shipping address, and order details.
            </p>
        </div>

        <div class="mb-4">
            <h2 class="h4 fw-bold">2. How We Use Your Information</h2>
            <p class="text-muted">
                We use your information to process orders, provide customer
                support, manage your account, communicate about your orders,
                and improve the CrisKidsWear shopping experience.
            </p>
        </div>

        <div class="mb-4">
            <h2 class="h4 fw-bold">3. Payment Information</h2>
            <p class="text-muted">
                Payments made through our online payment gateway are processed
                by the relevant payment service provider. CrisKidsWear does
                not store your complete card or banking credentials on our
                website.
            </p>
        </div>

        <div class="mb-4">
            <h2 class="h4 fw-bold">4. Account Security</h2>
            <p class="text-muted">
                We take reasonable measures to protect account and order
                information. You are responsible for keeping your account
                credentials confidential.
            </p>
        </div>

        <div class="mb-4">
            <h2 class="h4 fw-bold">5. Cookies</h2>
            <p class="text-muted">
                Our website may use cookies and similar technologies to
                maintain sessions, remember preferences, and provide essential
                website functionality.
            </p>
        </div>

        <div class="mb-4">
            <h2 class="h4 fw-bold">6. Changes to This Policy</h2>
            <p class="text-muted">
                We may update this Privacy Policy from time to time. Any
                changes will be reflected on this page.
            </p>
        </div>

        <div class="border rounded-4 p-4 bg-light">
            <h2 class="h5 fw-bold">Questions about privacy?</h2>
            <p class="text-muted mb-3">
                If you have questions about this policy or your personal
                information, please contact CrisKidsWear.
            </p>

            <a asp-controller="Home"
               asp-action="Contact"
               class="btn btn-dark rounded-pill px-4">
                Contact Us
            </a>
        </div>
    </div>
</div>