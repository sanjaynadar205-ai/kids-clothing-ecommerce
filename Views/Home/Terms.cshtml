@{
    ViewData["Title"] = "Terms & Conditions";
}

<div class="container py-5">
    <div class="mx-auto" style="max-width: 900px;">
        <div class="mb-5">
            <span class="text-uppercase small fw-semibold text-muted">CrisKidsWear</span>
            <h1 class="display-5 fw-bold mt-2">Terms & Conditions</h1>
            <p class="text-muted mb-0">
                These terms govern your use of the CrisKidsWear website and
                online shopping services.
            </p>
        </div>

        <div class="mb-4">
            <h2 class="h4 fw-bold">1. Use of Our Website</h2>
            <p class="text-muted">
                By using CrisKidsWear, you agree to use the website lawfully
                and provide accurate information when creating an account or
                placing an order.
            </p>
        </div>

        <div class="mb-4">
            <h2 class="h4 fw-bold">2. Products and Availability</h2>
            <p class="text-muted">
                We make reasonable efforts to display accurate product
                descriptions, images, prices, sizes, colours, and availability.
                Product availability may change without prior notice.
            </p>
        </div>

        <div class="mb-4">
            <h2 class="h4 fw-bold">3. Prices</h2>
            <p class="text-muted">
                Product prices are displayed on the website in Indian Rupees.
                Applicable shipping charges and discounts are shown during the
                checkout process.
            </p>
        </div>

        <div class="mb-4">
            <h2 class="h4 fw-bold">4. Orders</h2>
            <p class="text-muted">
                An order is subject to product availability and successful
                payment or confirmation of the selected payment method.
                CrisKidsWear reserves the right to cancel an order where
                necessary, including in cases of pricing or inventory errors.
            </p>
        </div>

        <div class="mb-4">
            <h2 class="h4 fw-bold">5. User Accounts</h2>
            <p class="text-muted">
                Customers are responsible for maintaining the confidentiality
                of their account credentials and for activity performed through
                their account.
            </p>
        </div>

        <div class="mb-4">
            <h2 class="h4 fw-bold">6. Intellectual Property</h2>
            <p class="text-muted">
                Website content, branding, graphics, text, product presentation,
                and other materials belonging to CrisKidsWear may not be
                reproduced or used without appropriate permission.
            </p>
        </div>

        <div class="mb-4">
            <h2 class="h4 fw-bold">7. Policy Changes</h2>
            <p class="text-muted">
                CrisKidsWear may update these terms when necessary. Continued
                use of the website after an update constitutes acceptance of
                the revised terms.
            </p>
        </div>

        <div class="border rounded-4 p-4 bg-light">
            <h2 class="h5 fw-bold">Need assistance?</h2>
            <p class="text-muted mb-3">
                Contact our team if you have questions regarding these terms.
            </p>

            <a asp-controller="Home"
               asp-action="Contact"
               class="btn btn-dark rounded-pill px-4">
                Contact Us
            </a>
        </div>
    </div>
</div>