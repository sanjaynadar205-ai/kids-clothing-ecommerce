@{
    ViewData["Title"] = "Cancellation & Refund Policy";
}

<div class="container py-5">
    <div class="mx-auto" style="max-width: 900px;">
        <div class="mb-5">
            <span class="text-uppercase small fw-semibold text-muted">CrisKidsWear</span>
            <h1 class="display-5 fw-bold mt-2">Cancellation & Refund Policy</h1>
            <p class="text-muted mb-0">
                Information about order cancellation, returns, and refunds.
            </p>
        </div>

        <div class="mb-4">
            <h2 class="h4 fw-bold">1. Order Cancellation</h2>
            <p class="text-muted">
                Cancellation availability depends on the current status of
                your order. Orders that have already been processed or shipped
                may not be eligible for cancellation.
            </p>
        </div>

        <div class="mb-4">
            <h2 class="h4 fw-bold">2. Cancellation by CrisKidsWear</h2>
            <p class="text-muted">
                We may cancel an order in circumstances such as product
                unavailability, incorrect pricing, suspected fraudulent
                activity, or other operational reasons.
            </p>
        </div>

        <div class="mb-4">
            <h2 class="h4 fw-bold">3. Refunds for Prepaid Orders</h2>
            <p class="text-muted">
                Where a prepaid order is cancelled and a refund is approved,
                the refund will be processed through the applicable payment
                channel and subject to the payment provider's processing
                timelines.
            </p>
        </div>

        <div class="mb-4">
            <h2 class="h4 fw-bold">4. Cash on Delivery</h2>
            <p class="text-muted">
                For Cash on Delivery orders, no online payment refund is
                required where the order is cancelled before payment is made.
            </p>
        </div>

        <div class="mb-4">
            <h2 class="h4 fw-bold">5. Product Issues</h2>
            <p class="text-muted">
                If an item is damaged, defective, incorrect, or otherwise
                qualifies for a return under our applicable policy, please
                contact us with your order information and details of the issue.
            </p>
        </div>

        <div class="mb-4">
            <h2 class="h4 fw-bold">6. Refund Processing</h2>
            <p class="text-muted">
                Approved refunds may take additional time to appear in the
                customer's account depending on the bank, card issuer, UPI
                provider, or payment service provider.
            </p>
        </div>

        <div class="border rounded-4 p-4 bg-light">
            <h2 class="h5 fw-bold">Need help with an order?</h2>
            <p class="text-muted mb-3">
                Contact CrisKidsWear with your order details for assistance.
            </p>

            <a asp-controller="Home"
               asp-action="Contact"
               class="btn btn-dark rounded-pill px-4">
                Contact Us
            </a>
        </div>
    </div>
</div>