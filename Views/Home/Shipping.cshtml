@{
    ViewData["Title"] = "Shipping Policy";
}

<div class="container py-5">
    <div class="mx-auto" style="max-width: 900px;">
        <div class="mb-5">
            <span class="text-uppercase small fw-semibold text-muted">CrisKidsWear</span>
            <h1 class="display-5 fw-bold mt-2">Shipping Policy</h1>
            <p class="text-muted mb-0">
                Information about order processing, delivery, and shipping
                charges.
            </p>
        </div>

        <div class="mb-4">
            <h2 class="h4 fw-bold">1. Order Processing</h2>
            <p class="text-muted">
                Orders are processed after successful order confirmation.
                Processing times may vary depending on product availability,
                order volume, and operational requirements.
            </p>
        </div>

        <div class="mb-4">
            <h2 class="h4 fw-bold">2. Delivery</h2>
            <p class="text-muted">
                Delivery times depend on the customer's location, courier
                availability, weather conditions, and other circumstances
                outside our direct control.
            </p>
        </div>

        <div class="mb-4">
            <h2 class="h4 fw-bold">3. Shipping Charges</h2>
            <p class="text-muted">
                Applicable shipping charges are calculated and displayed
                during checkout before the customer confirms the order.
            </p>
        </div>

        <div class="mb-4">
            <h2 class="h4 fw-bold">4. Delivery Address</h2>
            <p class="text-muted">
                Customers are responsible for providing a complete and
                accurate delivery address, including postal code and contact
                information.
            </p>
        </div>

        <div class="mb-4">
            <h2 class="h4 fw-bold">5. Delayed Deliveries</h2>
            <p class="text-muted">
                Delivery may occasionally be delayed because of weather,
                transportation issues, public holidays, courier disruptions,
                incorrect addresses, or other unforeseen circumstances.
            </p>
        </div>

        <div class="mb-4">
            <h2 class="h4 fw-bold">6. Damaged or Incorrect Orders</h2>
            <p class="text-muted">
                If you receive a damaged, incorrect, or incomplete order,
                please contact CrisKidsWear as soon as possible with the
                relevant order details.
            </p>
        </div>

        <div class="border rounded-4 p-4 bg-light">
            <h2 class="h5 fw-bold">Questions about delivery?</h2>
            <p class="text-muted mb-3">
                Our team can help with shipping and order-related questions.
            </p>

            <a asp-controller="Home"
               asp-action="Contact"
               class="btn btn-dark rounded-pill px-4">
                Contact Us
            </a>
        </div>
    </div>
</div>