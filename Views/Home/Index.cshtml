@using KidsWearStore.Models
@{
    ViewData["Title"] = "Home";
    var categories = ViewBag.Categories as List<Category> ?? new();
    var featured = ViewBag.FeaturedProducts as List<Product> ?? new();
    var arrivals = ViewBag.NewArrivals as List<Product> ?? new();
    var best = ViewBag.BestSellers as List<Product> ?? new();
    var offers = ViewBag.Offers as List<Product> ?? new();
    var latest = ViewBag.LatestProducts as List<Product> ?? new();
    var heroProduct = featured.FirstOrDefault() ?? arrivals.FirstOrDefault() ?? latest.FirstOrDefault();
    var displayFeatured = featured.Any() ? featured : latest;
}

<main class="store-home">
    <section class="home-hero-pro">
        <div class="container-xl home-hero-grid">
            <div class="home-hero-copy">
                <span class="eyebrow"><i class="bi bi-stars"></i> NEW SEASON 2026</span>
                <h1>Made for <span>little moments.</span></h1>
                <p>Thoughtfully designed kidswear with comfortable fabrics, easy everyday fits and a polished look for every occasion.</p>
                <div class="home-hero-actions">
                    <a asp-controller="Products" asp-action="Index" class="btn btn-dark btn-lg px-4">Shop the collection <i class="bi bi-arrow-right ms-2"></i></a>
                    <a href="#featured" class="home-text-link">Explore bestsellers <i class="bi bi-arrow-down"></i></a>
                </div>
                <div class="home-proof-row">
                    <div><i class="bi bi-shield-check"></i><span>Secure checkout</span></div>
                    <div><i class="bi bi-truck"></i><span>Reliable delivery</span></div>
                    <div><i class="bi bi-arrow-repeat"></i><span>Easy returns</span></div>
                </div>
            </div>
            <div class="home-hero-visual">
                <div class="hero-blob hero-blob-one"></div>
                <div class="hero-blob hero-blob-two"></div>
                <div class="hero-product-stage">
                    @if (heroProduct != null && !string.IsNullOrWhiteSpace(heroProduct.MainImageUrl))
                    {
                        <img src="@heroProduct.MainImageUrl" alt="@heroProduct.Name" />
                    }
                    else
                    {
                        <div class="hero-empty"><i class="bi bi-bag-heart"></i><span>Kidswear collection</span></div>
                    }
                    <div class="hero-product-tag"><small>FEATURED</small><strong>@(heroProduct?.Category?.Name ?? "Kidswear")</strong></div>
                </div>
                <div class="hero-floating hero-floating-top"><strong>New</strong><span>2026 collection</span></div>
                <div class="hero-floating hero-floating-bottom"><i class="bi bi-patch-check-fill"></i><span>Quality checked</span></div>
            </div>
        </div>
    </section>

    <section class="home-service-strip">
        <div class="container-xl service-grid">
            <div><i class="bi bi-truck"></i><div><strong>Delivery across India</strong><span>Reliable shipping on every order</span></div></div>
            <div><i class="bi bi-credit-card"></i><div><strong>Secure payments</strong><span>Razorpay and cash on delivery</span></div></div>
            <div><i class="bi bi-box-seam"></i><div><strong>Carefully packed</strong><span>Every order prepared with care</span></div></div>
            <div><i class="bi bi-headset"></i><div><strong>Customer support</strong><span>We are here when you need us</span></div></div>
        </div>
    </section>

    @if (categories.Any())
    {
        <section class="home-section-pro">
            <div class="container-xl">
                <div class="home-section-head">
                    <div><span class="section-kicker">SHOP BY CATEGORY</span><h2>Find their everyday favourites</h2></div>
                    <a asp-controller="Products" asp-action="Index">View all categories <i class="bi bi-arrow-up-right"></i></a>
                </div>
                <div class="category-grid-pro">
                    @foreach (var category in categories.Take(5))
                    {
                        <a asp-controller="Products" asp-action="Index" asp-route-categoryId="@category.Id" class="category-card-pro">
                            <div class="category-card-image">
                                @if (!string.IsNullOrWhiteSpace(category.ImageUrl)) { <img src="@category.ImageUrl" alt="@category.Name" /> }
                                else { <i class="bi bi-grid-3x3-gap"></i> }
                            </div>
                            <div class="category-card-body"><span>COLLECTION</span><h3>@category.Name</h3><p>@(string.IsNullOrWhiteSpace(category.Description) ? "Explore the collection" : category.Description)</p><b>Shop now <i class="bi bi-arrow-right"></i></b></div>
                        </a>
                    }
                    <a asp-controller="Products" asp-action="Index" asp-route-sort="discount" class="category-card-pro category-offer-card">
                        <div class="offer-copy-pro"><span>LIMITED-TIME OFFERS</span><h3>Good style.<br />Better value.</h3><p>Discover selected kidswear at special prices.</p><b>Shop sale <i class="bi bi-arrow-right"></i></b></div>
                    </a>
                </div>
            </div>
        </section>
    }

    @if (displayFeatured.Any())
    {
        <section class="home-section-pro home-products-pro" id="featured">
            <div class="container-xl">
                <div class="home-section-head">
                    <div><span class="section-kicker">CURATED FOR YOU</span><h2>Popular right now</h2></div>
                    <a asp-controller="Products" asp-action="Index" asp-route-sort="featured">Shop all <i class="bi bi-arrow-up-right"></i></a>
                </div>
                <div class="product-grid-pro">
                    @foreach (var product in displayFeatured.Take(8))
                    {
                        var sale = product.DiscountPrice.HasValue && product.DiscountPrice.Value < product.Price;
                        var price = sale ? product.DiscountPrice!.Value : product.Price;
                        <article class="product-card-pro">
                            <a asp-controller="Products" asp-action="Details" asp-route-id="@product.Id" class="product-card-media">
                                @if (product.IsNewArrival) { <span class="product-label label-dark">NEW</span> }
                                else if (sale) { <span class="product-label label-sale">SALE</span> }
                                @if (!string.IsNullOrWhiteSpace(product.MainImageUrl)) { <img src="@product.MainImageUrl" alt="@product.Name" loading="lazy" /> }
                                else { <div class="product-image-empty"><i class="bi bi-image"></i><span>No image</span></div> }
                                <span class="product-quick"><i class="bi bi-arrow-up-right"></i></span>
                            </a>
                            <div class="product-card-content">
                                <span class="product-category">@(product.Category?.Name ?? "Kidswear")</span>
                                <h3><a asp-controller="Products" asp-action="Details" asp-route-id="@product.Id">@product.Name</a></h3>
                                <div class="product-price-pro"><strong>₹@price.ToString("N0")</strong>@if (sale) { <del>₹@product.Price.ToString("N0")</del> }</div>
                                @if (product.StockQuantity > 0) { <span class="stock-note"><i class="bi bi-check2"></i> In stock</span> } else { <span class="stock-note out"><i class="bi bi-dash-circle"></i> Out of stock</span> }
                            </div>
                        </article>
                    }
                </div>
            </div>
        </section>
    }

    @if (offers.Any())
    {
        <section class="home-sale-banner">
            <div class="container-xl sale-banner-inner">
                <div><span class="section-kicker">THE EDIT</span><h2>Special prices on selected styles.</h2><p>Refresh their wardrobe with quality essentials and occasion-ready pieces.</p><a asp-controller="Products" asp-action="Index" asp-route-sort="discount" class="btn btn-light px-4">Shop offers <i class="bi bi-arrow-right ms-2"></i></a></div>
                <div class="sale-product-stack">
                    @foreach (var product in offers.Take(3))
                    {
                        <a asp-controller="Products" asp-action="Details" asp-route-id="@product.Id" class="sale-product-tile">
                            @if (!string.IsNullOrWhiteSpace(product.MainImageUrl)) { <img src="@product.MainImageUrl" alt="@product.Name" loading="lazy" /> } else { <i class="bi bi-bag"></i> }
                        </a>
                    }
                </div>
            </div>
        </section>
    }

    @if (arrivals.Any())
    {
        <section class="home-section-pro">
            <div class="container-xl">
                <div class="home-section-head"><div><span class="section-kicker">JUST IN</span><h2>New arrivals</h2></div><a asp-controller="Products" asp-action="Index" asp-route-sort="newest">See everything new <i class="bi bi-arrow-up-right"></i></a></div>
                <div class="mini-product-grid-pro">
                    @foreach (var product in arrivals.Take(4))
                    {
                        var price = product.DiscountPrice.HasValue && product.DiscountPrice.Value < product.Price ? product.DiscountPrice.Value : product.Price;
                        <a asp-controller="Products" asp-action="Details" asp-route-id="@product.Id" class="mini-product-pro">
                            <div>@if (!string.IsNullOrWhiteSpace(product.MainImageUrl)) { <img src="@product.MainImageUrl" alt="@product.Name" loading="lazy" /> } else { <i class="bi bi-image"></i> }</div>
                            <span>@(product.Category?.Name ?? "Kidswear")</span><h3>@product.Name</h3><strong>₹@price.ToString("N0")</strong>
                        </a>
                    }
                </div>
            </div>
        </section>
    }

    <section class="home-confidence">
        <div class="container-xl confidence-grid">
            <div><span class="section-kicker">WHY SHOP WITH US</span><h2>Designed around real family life.</h2><p>From first layers to special-day outfits, CrisKidsWear brings together comfortable styles that are easy to wear, easy to love and simple to shop.</p></div>
            <div class="confidence-list">
                <div><i class="bi bi-shield-check"></i><div><strong>Secure by design</strong><p>Protected sign-in and trusted payment options.</p></div></div>
                <div><i class="bi bi-box-seam"></i><div><strong>Thoughtful presentation</strong><p>Products and orders are organised for a smoother experience.</p></div></div>
                <div><i class="bi bi-heart"></i><div><strong>Built for families</strong><p>A clean shopping experience from discovery to delivery.</p></div></div>
            </div>
        </div>
    </section>
</main>

