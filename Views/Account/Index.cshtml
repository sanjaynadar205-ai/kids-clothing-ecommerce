@model KidsWearStore.Models.ApplicationUser

@{
    ViewData["Title"] = "My Account";
}

<div class="container py-5">
    <div class="mb-4">
        <h1 class="fw-bold">My Account</h1>
        <p class="text-muted">Manage your account and view your orders.</p>
    </div>

    <div class="row g-4">

        <div class="col-md-6">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body p-4">
                    <div class="fs-1 mb-3"></div>

                    <h4 class="fw-bold">Account Information</h4>

                    <p class="mb-2">
                        <strong>Name:</strong>
                        @Model.FirstName @Model.LastName
                    </p>

                    <p class="mb-2">
                        <strong>Email:</strong>
                        @Model.Email
                    </p>

                    <p class="mb-2">
                        <strong>Phone:</strong>
                        @(Model.PhoneNumber ?? "Not provided")
                    </p>

                    <a asp-area="Identity"
                       asp-page="/Account/Manage/Index"
                       class="btn btn-dark mt-3">
                        Manage Account
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body p-4">
                    <div class="fs-1 mb-3"></div>

                    <h4 class="fw-bold">My Orders</h4>

                    <p class="text-muted">
                        View your previous purchases, payment status
                        and delivery status.
                    </p>

                    <a asp-action="Orders"
                       class="btn btn-primary mt-2">
                        View My Orders
                    </a>
                </div>
            </div>
        </div>

    </div>
</div>