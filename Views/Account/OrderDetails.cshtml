@model KidsWearStore.Models.Order

@{
    ViewData["Title"] = "Order Details";

    var canCancel =
        Model.Status == KidsWearStore.Models.OrderStatus.Pending &&
        !string.Equals(
            Model.PaymentStatus,
            "Paid",
            StringComparison.OrdinalIgnoreCase);
}

<div class="container py-5">

    <!-- HEADER -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">

        <div>
            <h1 class="fw-bold mb-1">
                Order Details
            </h1>

            <p class="text-muted mb-0">
                Order #@Model.OrderNumber
            </p>
        </div>

        <div class="d-flex gap-2">

            <a asp-action="Orders"
               class="btn btn-outline-dark">
                ← My Orders
            </a>

            @if (canCancel)
            {
                <form asp-action="CancelOrder"
                      method="post"
                      class="d-inline"
                      onsubmit="return confirmCancelOrder();">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="orderNumber"
                           value="@Model.OrderNumber" />

                    <button type="submit"
                            class="btn btn-outline-danger">
                         Cancel Order
                    </button>

                </form>
            }

        </div>

    </div>


    <!-- SUCCESS / ERROR MESSAGE -->

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4"
             role="alert">

            <strong>Success!</strong>
            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4"
             role="alert">

            <strong>Unable to cancel order.</strong>
            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <div class="row g-4">

        <!-- ORDER STATUS -->
        <div class="col-12">

            <div class="card border-0 shadow-sm">

                <div class="card-body p-4">

                    <h4 class="fw-bold mb-4">
                        Order Status
                    </h4>

                    <div class="row g-4">

                        <!-- ORDER DATE -->
                        <div class="col-md-3">
    <small class="text-muted d-block">
        Order Date
    </small>

    <strong>
        @Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")
    </strong>
</div>

                        <!-- ORDER STATUS -->
                        <div class="col-md-3">

                            <small class="text-muted d-block mb-1">
                                Order Status
                            </small>

                            @switch (Model.Status)
                            {
                                case KidsWearStore.Models.OrderStatus.Pending:

                                    <span class="badge bg-primary">
                                        Pending
                                    </span>

                                    break;

                                case KidsWearStore.Models.OrderStatus.Confirmed:

                                    <span class="badge bg-info text-dark">
                                        Confirmed
                                    </span>

                                    break;

                                case KidsWearStore.Models.OrderStatus.Processing:

                                    <span class="badge bg-warning text-dark">
                                        Processing
                                    </span>

                                    break;

                                case KidsWearStore.Models.OrderStatus.Shipped:

                                    <span class="badge bg-primary">
                                        Shipped
                                    </span>

                                    break;

                                case KidsWearStore.Models.OrderStatus.Delivered:

                                    <span class="badge bg-success">
                                        Delivered
                                    </span>

                                    break;

                                case KidsWearStore.Models.OrderStatus.Cancelled:

                                    <span class="badge bg-danger">
                                        Cancelled
                                    </span>

                                    break;
                            }

                        </div>


                        <!-- PAYMENT METHOD -->
                        <div class="col-md-3">

                            <small class="text-muted d-block mb-1">
                                Payment Method
                            </small>

                            <strong>
                                @Model.PaymentMethod
                            </strong>

                        </div>


                        <!-- PAYMENT STATUS -->
                        <div class="col-md-3">

                            <small class="text-muted d-block mb-1">
                                Payment Status
                            </small>

                            @if (string.Equals(
                                Model.PaymentStatus,
                                "Paid",
                                StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="badge bg-success">
                                    Paid
                                </span>
                            }
                            else if (string.Equals(
                                Model.PaymentStatus,
                                "Cancelled",
                                StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="badge bg-danger">
                                    Cancelled
                                </span>
                            }
                            else if (string.Equals(
                                Model.PaymentStatus,
                                "Created",
                                StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="badge bg-info text-dark">
                                    Payment Created
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">
                                    @Model.PaymentStatus
                                </span>
                            }

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- PRODUCTS -->
        <div class="col-lg-8">

            <div class="card border-0 shadow-sm">

                <div class="card-body p-4">

                    <h4 class="fw-bold mb-4">
                        Products
                    </h4>

                    @if (Model.OrderItems != null &&
                         Model.OrderItems.Any())
                    {
                        @foreach (var item in Model.OrderItems)
                        {
                            <div class="d-flex align-items-center gap-3 border-bottom py-3">

                                <!-- IMAGE -->
                                <div>

                                    @if (!string.IsNullOrWhiteSpace(
                                        item.Product?.MainImageUrl))
                                    {
                                        <img src="@item.Product.MainImageUrl"
                                             alt="@item.ProductName"
                                             style="
                                                width:80px;
                                                height:80px;
                                                object-fit:cover;
                                                border-radius:10px;
                                             " />
                                    }
                                    else
                                    {
                                        <div style="
                                            width:80px;
                                            height:80px;
                                            background:#f1f1f1;
                                            border-radius:10px;
                                            display:flex;
                                            align-items:center;
                                            justify-content:center;
                                            font-size:30px;">
                                            
                                        </div>
                                    }

                                </div>


                                <!-- PRODUCT INFORMATION -->
                                <div class="flex-grow-1">

                                    <h6 class="fw-bold mb-1">
                                        @item.ProductName
                                    </h6>

                                    <div class="text-muted">
                                        ₹@item.UnitPrice.ToString("N2")
                                        × @item.Quantity
                                    </div>

                                </div>


                                <!-- TOTAL -->
                                <strong>
                                    ₹@item.TotalPrice.ToString("N2")
                                </strong>

                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted mb-0">
                            No products found for this order.
                        </p>
                    }

                </div>

            </div>

        </div>


        <!-- RIGHT SIDE -->
        <div class="col-lg-4">


            <!-- ORDER SUMMARY -->
            <div class="card border-0 shadow-sm mb-4">

                <div class="card-body p-4">

                    <h4 class="fw-bold mb-4">
                        Order Summary
                    </h4>


                    <div class="d-flex justify-content-between mb-2">

                        <span>
                            Subtotal
                        </span>

                        <span>
                            ₹@Model.Subtotal.ToString("N2")
                        </span>

                    </div>


                    <div class="d-flex justify-content-between mb-2">

                        <span>
                            Discount
                        </span>

                        <span>
                            − ₹@Model.Discount.ToString("N2")
                        </span>

                    </div>


                    @{
                        var shipping = Model.TotalAmount -
                                        (Model.Subtotal - Model.Discount);
                    }

                    @if (shipping > 0)
                    {
                        <div class="d-flex justify-content-between mb-2">

                            <span>
                                Shipping
                            </span>

                            <span>
                                ₹@shipping.ToString("N2")
                            </span>

                        </div>
                    }
                    else
                    {
                        <div class="d-flex justify-content-between mb-2">

                            <span>
                                Shipping
                            </span>

                            <span class="text-success">
                                Free
                            </span>

                        </div>
                    }


                    <hr />


                    <div class="d-flex justify-content-between">

                        <strong>
                            Total
                        </strong>

                        <strong class="fs-5">
                            ₹@Model.TotalAmount.ToString("N2")
                        </strong>

                    </div>

                </div>

            </div>


            <!-- DELIVERY ADDRESS -->
            <div class="card border-0 shadow-sm">

                <div class="card-body p-4">

                    <h4 class="fw-bold mb-3">
                        Delivery Address
                    </h4>


                    <p class="mb-1">
                        <strong>
                            @Model.CustomerName
                        </strong>
                    </p>


                    <p class="mb-1">
                        @Model.ShippingAddress
                    </p>


                    <p class="mb-1">
                        @Model.City, @Model.State
                    </p>


                    <p class="mb-1">
                        @Model.PostalCode
                    </p>


                    @if (!string.IsNullOrWhiteSpace(Model.CustomerPhone))
                    {
                        <p class="mb-0">
                             @Model.CustomerPhone
                        </p>
                    }

                </div>

            </div>

        </div>

    </div>

</div>


<script>

    function confirmCancelOrder() {

        return confirm(
            "Are you sure you want to cancel this order?\n\n" +
            "This action cannot be undone."
        );

    }

</script>