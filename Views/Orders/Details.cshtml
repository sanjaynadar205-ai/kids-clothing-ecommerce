@model KidsWearStore.Models.Order

@{
    ViewData["Title"] = "Order Details";

    var status = Model.Status.ToString();
    var progress = Model.Status switch
    {
        KidsWearStore.Models.OrderStatus.Pending => 25,
        KidsWearStore.Models.OrderStatus.Confirmed => 45,
        KidsWearStore.Models.OrderStatus.Processing => 65,
        KidsWearStore.Models.OrderStatus.Shipped => 85,
        KidsWearStore.Models.OrderStatus.Delivered => 100,
        KidsWearStore.Models.OrderStatus.Cancelled => 100,
        _ => 25
    };
}

<div class="order-details-page">

    <div class="page-heading">

        <div>
            <a asp-controller="Orders"
               asp-action="Index"
               class="back-link">
                <i class="bi bi-arrow-left"></i>
                Back to My Orders
            </a>

            <h1>Order Details</h1>

            <p>
                Order #@Model.OrderNumber
                <span class="separator">|</span>
                @Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")
            </p>
        </div>

        <span class="status-badge status-@status.ToLowerInvariant()">
            @status
        </span>

    </div>

    @if (Model.Status != KidsWearStore.Models.OrderStatus.Cancelled)
    {
        <div class="tracking-card">

            <div class="tracking-heading">
                <div>
                    <h2>Order status</h2>
                    <p>Your order is currently <strong>@status</strong>.</p>
                </div>

                <i class="bi bi-box-seam"></i>
            </div>

            <div class="progress-track">
                <div class="progress-fill"
                     style="width:@progress%"></div>
            </div>

            <div class="tracking-steps">

                <div class="tracking-step @(Model.Status >= KidsWearStore.Models.OrderStatus.Pending ? "active" : "")">
                    <span><i class="bi bi-receipt"></i></span>
                    <strong>Placed</strong>
                </div>

                <div class="tracking-step @(Model.Status >= KidsWearStore.Models.OrderStatus.Confirmed ? "active" : "")">
                    <span><i class="bi bi-check2"></i></span>
                    <strong>Confirmed</strong>
                </div>

                <div class="tracking-step @(Model.Status >= KidsWearStore.Models.OrderStatus.Processing ? "active" : "")">
                    <span><i class="bi bi-box-seam"></i></span>
                    <strong>Processing</strong>
                </div>

                <div class="tracking-step @(Model.Status >= KidsWearStore.Models.OrderStatus.Shipped ? "active" : "")">
                    <span><i class="bi bi-truck"></i></span>
                    <strong>Shipped</strong>
                </div>

                <div class="tracking-step @(Model.Status >= KidsWearStore.Models.OrderStatus.Delivered ? "active" : "")">
                    <span><i class="bi bi-house-check"></i></span>
                    <strong>Delivered</strong>
                </div>

            </div>

        </div>
    }
    else
    {
        <div class="cancelled-card">
            <i class="bi bi-x-circle"></i>

            <div>
                <h3>Order Cancelled</h3>
                <p>
                    This order was cancelled by
                    @(string.IsNullOrWhiteSpace(Model.CancelledBy)
                        ? "the store"
                        : Model.CancelledBy).
                </p>
            </div>
        </div>
    }

    <div class="details-grid">

        <div class="main-column">

            <section class="details-card">

                <div class="card-heading">
                    <h2>Items in this order</h2>
                    <span>
                        @Model.OrderItems.Sum(x => x.Quantity)
                        @(Model.OrderItems.Sum(x => x.Quantity) == 1 ? "item" : "items")
                    </span>
                </div>

                <div class="items-list">

                    @foreach (var item in Model.OrderItems)
                    {
                        <div class="order-item">

                            <div class="item-image">

                                @if (item.Product != null &&
                                     !string.IsNullOrWhiteSpace(item.Product.MainImageUrl))
                                {
                                    <img src="@item.Product.MainImageUrl"
                                         alt="@item.Product.Name" />
                                }
                                else
                                {
                                    <i class="bi bi-image"></i>
                                }

                            </div>

                            <div class="item-info">

                                <h3>
                                    @(item.Product?.Name ?? "Product")
                                </h3>

                                <p>
                                    Quantity: @item.Quantity
                                </p>

                                <span>
                                    ₹@item.UnitPrice.ToString("N2") each
                                </span>

                            </div>

                            <strong class="item-total">
                                ₹@item.TotalPrice.ToString("N2")
                            </strong>

                        </div>
                    }

                </div>

            </section>

            <section class="details-card">

                <div class="card-heading">
                    <h2>Delivery information</h2>
                </div>

                <div class="address-grid">

                    <div>
                        <span class="field-label">Customer</span>
                        <strong>@Model.CustomerName</strong>
                    </div>

                    <div>
                        <span class="field-label">Phone</span>
                        <strong>@Model.CustomerPhone</strong>
                    </div>

                    <div>
                        <span class="field-label">Email</span>
                        <strong>@Model.CustomerEmail</strong>
                    </div>

                    <div class="full-width">
                        <span class="field-label">Shipping address</span>
                        <strong>
                            @Model.ShippingAddress,
                            @Model.City,
                            @Model.State -
                            @Model.PostalCode
                        </strong>
                    </div>

                </div>

            </section>

        </div>

        <aside class="side-column">

            <section class="details-card">

                <div class="card-heading">
                    <h2>Payment</h2>
                </div>

                <div class="payment-row">
                    <span>Method</span>
                    <strong>@Model.PaymentMethod</strong>
                </div>

                <div class="payment-row">
                    <span>Status</span>

                    @if (Model.PaymentStatus == "Paid")
                    {
                        <strong class="paid-text">Paid</strong>
                    }
                    else
                    {
                        <strong>@Model.PaymentStatus</strong>
                    }
                </div>

            </section>

            <section class="details-card">

                <div class="card-heading">
                    <h2>Order summary</h2>
                </div>

                <div class="summary-row">
                    <span>Subtotal</span>
                    <strong>₹@Model.Subtotal.ToString("N2")</strong>
                </div>

                <div class="summary-row">
                    <span>Discount</span>
                    <strong>
                        @(Model.Discount > 0
                            ? "- ₹" + Model.Discount.ToString("N2")
                            : "₹0.00")
                    </strong>
                </div>

                <div class="summary-row">
                    <span>Shipping</span>
                    <strong>
                        @(Model.TotalAmount - Model.Subtotal + Model.Discount == 0
                            ? "FREE"
                            : "₹49.00")
                    </strong>
                </div>

                <div class="summary-total">
                    <span>Total</span>
                    <strong>₹@Model.TotalAmount.ToString("N2")</strong>
                </div>

            </section>

            <a asp-controller="Products"
               asp-action="Index"
               class="btn btn-dark continue-btn">
                <i class="bi bi-bag"></i>
                Continue Shopping
            </a>

        </aside>

    </div>

</div>

<style>
    .order-details-page {
        max-width: 1180px;
        margin: 0 auto;
        padding: 45px 20px 80px;
    }

    .page-heading {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 20px;
        margin-bottom: 30px;
    }

    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        margin-bottom: 14px;
        color: #555;
        text-decoration: none;
        font-size: 13px;
        font-weight: 600;
    }

    .back-link:hover {
        color: #000;
    }

    .page-heading h1 {
        margin: 0;
        font-size: clamp(30px, 5vw, 42px);
        letter-spacing: -1.3px;
    }

    .page-heading p {
        margin: 8px 0 0;
        color: #777;
        font-size: 14px;
    }

    .separator {
        margin: 0 8px;
        color: #bbb;
    }

    .status-badge {
        padding: 8px 13px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 700;
        background: #f3f4f6;
        color: #374151;
    }

    .status-confirmed,
    .status-processing {
        background: #eef4ff;
        color: #2457a6;
    }

    .status-shipped {
        background: #f2efff;
        color: #5b42a6;
    }

    .status-delivered {
        background: #edf8f1;
        color: #237343;
    }

    .status-cancelled {
        background: #fff0f0;
        color: #b42318;
    }

    .tracking-card,
    .cancelled-card,
    .details-card {
        background: #fff;
        border: 1px solid #e8e8e8;
        border-radius: 18px;
    }

    .tracking-card {
        padding: 25px;
        margin-bottom: 22px;
    }

    .tracking-heading {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .tracking-heading h2,
    .card-heading h2 {
        margin: 0;
        font-size: 17px;
    }

    .tracking-heading p {
        margin: 6px 0 0;
        color: #777;
        font-size: 13px;
    }

    .tracking-heading > i {
        font-size: 28px;
        color: #555;
    }

    .progress-track {
        height: 5px;
        margin: 28px 0 22px;
        background: #eeeeee;
        border-radius: 999px;
        overflow: hidden;
    }

    .progress-fill {
        height: 100%;
        background: #111;
        border-radius: inherit;
        transition: width .3s ease;
    }

    .tracking-steps {
        display: flex;
        justify-content: space-between;
    }

    .tracking-step {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 7px;
        color: #aaa;
        font-size: 11px;
    }

    .tracking-step span {
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #f1f1f1;
        color: #999;
    }

    .tracking-step.active {
        color: #222;
    }

    .tracking-step.active span {
        background: #111;
        color: #fff;
    }

    .cancelled-card {
        padding: 22px;
        margin-bottom: 22px;
        display: flex;
        align-items: center;
        gap: 15px;
        background: #fff7f7;
        border-color: #f0dada;
    }

    .cancelled-card > i {
        font-size: 28px;
        color: #b42318;
    }

    .cancelled-card h3 {
        margin: 0;
        font-size: 16px;
    }

    .cancelled-card p {
        margin: 4px 0 0;
        color: #777;
        font-size: 13px;
    }

    .details-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 340px;
        gap: 22px;
    }

    .main-column,
    .side-column {
        display: flex;
        flex-direction: column;
        gap: 22px;
    }

    .details-card {
        overflow: hidden;
    }

    .card-heading {
        padding: 20px 22px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1px solid #eeeeee;
    }

    .card-heading > span {
        color: #777;
        font-size: 12px;
    }

    .items-list {
        padding: 0 22px;
    }

    .order-item {
        display: grid;
        grid-template-columns: 78px 1fr auto;
        align-items: center;
        gap: 16px;
        padding: 18px 0;
        border-bottom: 1px solid #eeeeee;
    }

    .order-item:last-child {
        border-bottom: 0;
    }

    .item-image {
        width: 78px;
        height: 92px;
        border-radius: 10px;
        background: #f6f6f6;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #999;
        font-size: 24px;
    }

    .item-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .item-info h3 {
        margin: 0 0 7px;
        font-size: 15px;
    }

    .item-info p {
        margin: 0 0 5px;
        color: #777;
        font-size: 13px;
    }

    .item-info span {
        color: #555;
        font-size: 12px;
    }

    .item-total {
        font-size: 15px;
        white-space: nowrap;
    }

    .address-grid {
        padding: 22px;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
    }

    .address-grid > div {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .address-grid .full-width {
        grid-column: 1 / -1;
    }

    .field-label {
        color: #888;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: .6px;
        font-weight: 700;
    }

    .address-grid strong {
        font-size: 13px;
        line-height: 1.6;
        font-weight: 600;
    }

    .payment-row,
    .summary-row {
        padding: 15px 22px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        border-bottom: 1px solid #eeeeee;
        font-size: 13px;
    }

    .payment-row span,
    .summary-row span {
        color: #777;
    }

    .payment-row strong,
    .summary-row strong {
        text-align: right;
    }

    .paid-text {
        color: #237343;
    }

    .summary-total {
        padding: 20px 22px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-size: 16px;
    }

    .summary-total strong {
        font-size: 20px;
    }

    .continue-btn {
        width: 100%;
        text-align: center;
        padding: 12px;
        border-radius: 10px;
    }

    @@media (max-width: 850px) {
        .details-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 600px) {
        .order-details-page {
            padding: 30px 15px 60px;
        }

        .page-heading {
            align-items: flex-start;
            flex-direction: column;
        }

        .tracking-card {
            padding: 20px 15px;
        }

        .tracking-step strong {
            font-size: 9px;
        }

        .order-item {
            grid-template-columns: 64px 1fr;
        }

        .item-image {
            width: 64px;
            height: 78px;
        }

        .item-total {
            grid-column: 2;
        }

        .address-grid {
            grid-template-columns: 1fr;
        }

        .address-grid .full-width {
            grid-column: auto;
        }
    }
</style>