@using Microsoft.AspNetCore.Identity
@using KidsWearStore.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

<title>@ViewData["Title"] - CrisKidsWear</title>
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    @RenderSection("Styles", required: false)
</head>

<body>

    <header>

        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom sticky-top">

            <div class="container">

                <a class="navbar-brand fw-bold d-flex align-items-center"
                   asp-controller="Home"
                   asp-action="Index">

                

                    <span class="ms-2">
    CrisKidsWear
</span>

                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">

                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0">

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">
                                Home
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Products"
                               asp-action="Index">
                                Shop
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="About">
                                About Us
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Contact">
                                Contact Us
                            </a>
                        </li>

                        @if (SignInManager.IsSignedIn(User))
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Wishlist"
                                   asp-action="Index">

                                    <i class="bi bi-heart me-1"></i>
                                    Wishlist

                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Cart"
                                   asp-action="Index">

                                    <i class="bi bi-bag me-1"></i>
                                    Cart

                                </a>
                            </li>
                        }

                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Admin"
                                   asp-action="Index">

                                    <i class="bi bi-speedometer2 me-1"></i>
                                    Admin

                                </a>
                            </li>
                        }

                        @if (User.IsInRole("ProductManager") || User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Products"
                                   asp-action="Manage">

                                    <i class="bi bi-box-seam me-1"></i>
                                    Manage Products

                                </a>
                            </li>
                        }

                    </ul>

                    <div class="d-flex align-items-center gap-2">

                        @if (SignInManager.IsSignedIn(User))
                        {
                            <div class="dropdown">

                                <button class="btn btn-light border dropdown-toggle"
                                        type="button"
                                        data-bs-toggle="dropdown"
                                        aria-expanded="false">

                                    <i class="bi bi-person-circle me-1"></i>
                                    Account

                                </button>

                                <ul class="dropdown-menu dropdown-menu-end shadow-sm">

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Account"
                                           asp-action="Index">

                                            <i class="bi bi-person me-2"></i>
                                            My Account

                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Orders"
                                           asp-action="Index">

                                            <i class="bi bi-box-seam me-2"></i>
                                            My Orders

                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Wishlist"
                                           asp-action="Index">

                                            <i class="bi bi-heart me-2"></i>
                                            Wishlist

                                        </a>
                                    </li>

                                    <li>
                                        <hr class="dropdown-divider" />
                                    </li>

                                    <li>

                                        <form asp-controller="Account"
                                              asp-action="Logout"
                                              method="post">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="dropdown-item text-danger">

                                                <i class="bi bi-box-arrow-right me-2"></i>
                                                Logout

                                            </button>

                                        </form>

                                    </li>

                                </ul>

                            </div>
                        }
                        else
                        {
                            <a class="btn btn-outline-dark"
                               asp-controller="Account"
                               asp-action="Login">

                                Login

                            </a>

                            <a class="btn btn-dark"
                               asp-controller="Account"
                               asp-action="Register">

                                Create Account

                            </a>
                        }

                    </div>

                </div>

            </div>

        </nav>

    </header>


    <main>

        @RenderBody()

    </main>


    <footer class="bg-dark text-white mt-5">

        <div class="container py-5">

            <div class="row g-4">

                <div class="col-lg-4 col-md-6">

                    <h4 class="fw-bold mb-3">
                        CrisKidsWear
                    </h4>

                    <p class="text-white-50">
                        Stylish, comfortable and quality clothing
                        designed for kids of every age.
                    </p>

                </div>

                <div class="col-lg-2 col-md-6">

                    <h6 class="fw-bold mb-3">
                        Shop
                    </h6>

                    <ul class="list-unstyled">

                        <li class="mb-2">
                            <a class="text-white-50 text-decoration-none"
                               asp-controller="Products"
                               asp-action="Index">
                                All Products
                            </a>
                        </li>

                        <li class="mb-2">
                            <a class="text-white-50 text-decoration-none"
                               asp-controller="Products"
                               asp-action="Index"
                               asp-route-sort="newest">
                                New Arrivals
                            </a>
                        </li>

                        <li class="mb-2">
                            <a class="text-white-50 text-decoration-none"
                               asp-controller="Products"
                               asp-action="Index"
                               asp-route-sort="price-low">
                                Best Deals
                            </a>
                        </li>

                    </ul>

                </div>

                <div class="col-lg-3 col-md-6">

                    <h6 class="fw-bold mb-3">
                        Customer
                    </h6>

                    <ul class="list-unstyled">

                        <li class="mb-2">
                            <a class="text-white-50 text-decoration-none"
                               asp-controller="Orders"
                               asp-action="Index">
                                My Orders
                            </a>
                        </li>

                        <li class="mb-2">
                            <a class="text-white-50 text-decoration-none"
                               asp-controller="Wishlist"
                               asp-action="Index">
                                Wishlist
                            </a>
                        </li>

                        <li class="mb-2">
                            <a class="text-white-50 text-decoration-none"
                               asp-controller="Cart"
                               asp-action="Index">
                                Shopping Cart
                            </a>
                        </li>

                    </ul>

                </div>

                <div class="col-lg-3 col-md-6">

                    <h6 class="fw-bold mb-3">
                        Information
                    </h6>

                    <ul class="list-unstyled">

                        <li class="mb-2">
                            <a class="text-white-50 text-decoration-none"
                               asp-controller="Home"
                               asp-action="About">
                                About Us
                            </a>
                        </li>

                        <li class="mb-2">
                            <a class="text-white-50 text-decoration-none"
                               asp-controller="Home"
                               asp-action="Contact">
                                Contact Us
                            </a>
                        </li>

                        <li class="mb-2">
                            <a class="text-white-50 text-decoration-none"
                               asp-controller="Home"
                               asp-action="Privacy">
                                Privacy Policy
                            </a>
                        </li>

                    </ul>

                </div>

            </div>

            <hr class="border-secondary my-4" />

            <div class="text-center">

                <p class="text-white-50 mb-0">
                    &copy; @DateTime.Now.Year CrisKidsWear.
                    All rights reserved.
                </p>

            </div>

        </div>

    </footer>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @RenderSection("Scripts", required: false)

</body>
</html>