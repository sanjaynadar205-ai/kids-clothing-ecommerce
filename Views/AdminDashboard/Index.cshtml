@model KidsWearStore.Controllers.AdminDashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="admin-dashboard">

    <div class="dashboard-header">
        <div>
            <h1>Admin Dashboard</h1>
            <p>Overview of your KidsWearStore business.</p>
        </div>

        <div class="dashboard-actions">
            <a asp-controller="AdminOrders"
               asp-action="Index"
               class="dashboard-btn">
                 Manage Orders
            </a>

            <a asp-controller="Products"
               asp-action="Index"
               class="dashboard-btn secondary">
                 Manage Products
            </a>
        </div>
    </div>

    <!-- MAIN STATISTICS -->

    <div class="stats-grid">

        <div class="stat-card">
            <div class="stat-icon"></div>
            <div>
                <span>Total Orders</span>
                <strong>@Model.TotalOrders</strong>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon"></div>
            <div>
                <span>Total Sales</span>
                <strong>₹@Model.TotalSales.ToString("N2")</strong>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon">⏳</div>
            <div>
                <span>Pending Orders</span>
                <strong>@Model.PendingOrders</strong>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon"></div>
            <div>
                <span>Customers</span>
                <strong>@Model.TotalCustomers</strong>
            </div>
        </div>

    </div>

    <!-- SALES -->

    <div class="section-grid">

        <div class="dashboard-card">
            <div class="card-heading">
                <h2>Sales Overview</h2>
            </div>

            <div class="sales-grid">

                <div class="sales-item">
                    <span>Today</span>
                    <strong>₹@Model.TodaySales.ToString("N2")</strong>
                </div>

                <div class="sales-item">
                    <span>This Month</span>
                    <strong>₹@Model.MonthlySales.ToString("N2")</strong>
                </div>

                <div class="sales-item">
                    <span>All Time</span>
                    <strong>₹@Model.TotalSales.ToString("N2")</strong>
                </div>

            </div>
        </div>

        <div class="dashboard-card">
            <div class="card-heading">
                <h2>Product Stock</h2>

                <a asp-controller="Products"
                   asp-action="Index">
                    View Products →
                </a>
            </div>

            <div class="stock-grid">

                <div>
                    <span>Total</span>
                    <strong>@Model.TotalProducts</strong>
                </div>

                <div>
                    <span>Active</span>
                    <strong>@Model.ActiveProducts</strong>
                </div>

                <div class="warning">
                    <span>Low Stock</span>
                    <strong>@Model.LowStockProducts</strong>
                </div>

                <div class="danger">
                    <span>Out of Stock</span>
                    <strong>@Model.OutOfStockProducts</strong>
                </div>

            </div>
        </div>

    </div>

    <!-- ORDER STATUS -->

    <div class="dashboard-card order-status-card">

        <div class="card-heading">
            <h2>Order Status</h2>

            <a asp-controller="AdminOrders"
               asp-action="Index">
                View All Orders →
            </a>
        </div>

        <div class="status-grid">

            <div class="status-item">
                <span>Pending</span>
                <strong>@Model.PendingOrders</strong>
            </div>

            <div class="status-item">
                <span>Confirmed</span>
                <strong>@Model.ConfirmedOrders</strong>
            </div>

            <div class="status-item">
                <span>Processing</span>
                <strong>@Model.ProcessingOrders</strong>
            </div>

            <div class="status-item">
                <span>Shipped</span>
                <strong>@Model.ShippedOrders</strong>
            </div>

            <div class="status-item">
                <span>Delivered</span>
                <strong>@Model.DeliveredOrders</strong>
            </div>

            <div class="status-item cancelled">
                <span>Cancelled</span>
                <strong>@Model.CancelledOrders</strong>
            </div>

        </div>

    </div>

    <!-- RECENT ORDERS -->

    <div class="dashboard-card">

        <div class="card-heading">
            <h2>Recent Orders</h2>

            <a asp-controller="AdminOrders"
               asp-action="Index">
                View All →
            </a>
        </div>

        @if (Model.RecentOrders.Any())
        {
            <div class="table-wrapper">

                <table class="orders-table">

                    <thead>
                        <tr>
                            <th>Order</th>
                            <th>Customer</th>
                            <th>Date</th>
                            <th>Total</th>
                            <th>Payment</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>

                    <tbody>

                    @foreach (var order in Model.RecentOrders)
                    {
                        <tr>

                            <td>
                                <strong>@order.OrderNumber</strong>
                            </td>

                            <td>
                                @(order.User?.FirstName ?? "Customer")
                                @(order.User?.LastName ?? "")
                            </td>

                            <td>
                                @order.CreatedAt
                                    .ToLocalTime()
                                    .ToString("dd MMM yyyy, hh:mm tt")
                            </td>

                            <td>
                                <strong>
                                    ₹@order.TotalAmount.ToString("N2")
                                </strong>
                            </td>

                            <td>
                                @order.PaymentStatus
                            </td>

                            <td>
                                <span class="status-badge status-@order.Status.ToString().ToLower()">
                                    @order.Status
                                </span>
                            </td>

                            <td>
                                <a asp-controller="AdminOrders"
                                   asp-action="Details"
                                   asp-route-orderNumber="@order.OrderNumber"
                                   class="view-btn">
                                    View
                                </a>
                            </td>

                        </tr>
                    }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="empty-dashboard">
                <div></div>
                <h3>No orders yet</h3>
                <p>Orders will appear here when customers place them.</p>
            </div>
        }

    </div>

    <!-- QUICK ACTIONS -->

    <div class="dashboard-card">

        <div class="card-heading">
            <h2>Quick Actions</h2>
        </div>

        <div class="quick-actions">

            <a asp-controller="Products"
               asp-action="Create"
               class="quick-action">
                <span></span>
                <strong>Add Product</strong>
                <small>Create a new product</small>
            </a>

            <a asp-controller="AdminOrders"
               asp-action="Index"
               class="quick-action">
                <span></span>
                <strong>Orders</strong>
                <small>Manage customer orders</small>
            </a>

            <a asp-controller="Admin"
               asp-action="Index"
               class="quick-action">
                <span></span>
                <strong>Users</strong>
                <small>Manage users and roles</small>
            </a>

        </div>

    </div>

</div>

<style>
.admin-dashboard {
    max-width: 1200px;
    margin: 0 auto;
    padding: 30px 18px 60px;
}

.dashboard-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    margin-bottom: 28px;
}

.dashboard-header h1 {
    margin: 0 0 6px;
    font-size: 32px;
    font-weight: 800;
}

.dashboard-header p {
    margin: 0;
    color: #71717a;
}

.dashboard-actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
}

.dashboard-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 11px 16px;
    border-radius: 10px;
    text-decoration: none;
    background: #18181b;
    color: white;
    font-weight: 700;
}

.dashboard-btn:hover {
    color: white;
    opacity: .9;
}

.dashboard-btn.secondary {
    background: #f4f4f5;
    color: #18181b;
    border: 1px solid #e4e4e7;
}

.dashboard-btn.secondary:hover {
    color: #18181b;
}

.stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-bottom: 20px;
}

.stat-card {
    background: white;
    border: 1px solid #e4e4e7;
    border-radius: 16px;
    padding: 22px;
    display: flex;
    align-items: center;
    gap: 15px;
    box-shadow: 0 5px 20px rgba(0,0,0,.04);
}

.stat-icon {
    width: 48px;
    height: 48px;
    border-radius: 13px;
    background: #f4f4f5;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
}

.stat-card span {
    display: block;
    color: #71717a;
    font-size: 13px;
    margin-bottom: 5px;
}

.stat-card strong {
    display: block;
    font-size: 22px;
    color: #18181b;
}

.section-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-bottom: 20px;
}

.dashboard-card {
    background: white;
    border: 1px solid #e4e4e7;
    border-radius: 16px;
    padding: 22px;
    margin-bottom: 20px;
    box-shadow: 0 5px 20px rgba(0,0,0,.04);
}

.card-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 20px;
}

.card-heading h2 {
    margin: 0;
    font-size: 19px;
    font-weight: 800;
}

.card-heading a {
    color: #18181b;
    text-decoration: none;
    font-size: 13px;
    font-weight: 700;
}

.sales-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
}

.sales-item {
    background: #fafafa;
    border: 1px solid #f0f0f0;
    border-radius: 12px;
    padding: 16px;
}

.sales-item span,
.stock-grid span,
.status-item span {
    display: block;
    color: #71717a;
    font-size: 12px;
    margin-bottom: 6px;
}

.sales-item strong {
    font-size: 18px;
}

.stock-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
}

.stock-grid > div {
    padding: 14px;
    background: #fafafa;
    border-radius: 12px;
}

.stock-grid strong {
    font-size: 20px;
}

.stock-grid .warning strong {
    color: #b45309;
}

.stock-grid .danger strong {
    color: #dc2626;
}

.status-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 10px;
}

.status-item {
    background: #fafafa;
    border-radius: 12px;
    padding: 15px;
}

.status-item strong {
    font-size: 21px;
}

.status-item.cancelled strong {
    color: #dc2626;
}

.table-wrapper {
    overflow-x: auto;
}

.orders-table {
    width: 100%;
    border-collapse: collapse;
    min-width: 850px;
}

.orders-table th {
    text-align: left;
    font-size: 12px;
    color: #71717a;
    padding: 12px 10px;
    border-bottom: 1px solid #e4e4e7;
    white-space: nowrap;
}

.orders-table td {
    padding: 14px 10px;
    border-bottom: 1px solid #f0f0f0;
    font-size: 13px;
    white-space: nowrap;
}

.orders-table tbody tr:last-child td {
    border-bottom: none;
}

.view-btn {
    display: inline-block;
    padding: 7px 11px;
    border-radius: 8px;
    background: #18181b;
    color: white;
    text-decoration: none;
    font-size: 12px;
    font-weight: 700;
}

.view-btn:hover {
    color: white;
    opacity: .9;
}

.status-badge {
    display: inline-flex;
    padding: 5px 9px;
    border-radius: 999px;
    background: #f4f4f5;
    font-size: 11px;
    font-weight: 700;
}

.status-cancelled {
    background: #fee2e2;
    color: #b91c1c;
}

.status-delivered {
    background: #dcfce7;
    color: #15803d;
}

.status-shipped {
    background: #dbeafe;
    color: #1d4ed8;
}

.status-processing {
    background: #fef3c7;
    color: #92400e;
}

.status-confirmed {
    background: #e0e7ff;
    color: #4338ca;
}

.status-pending {
    background: #f4f4f5;
    color: #52525b;
}

.empty-dashboard {
    text-align: center;
    padding: 45px 20px;
}

.empty-dashboard > div {
    font-size: 42px;
}

.empty-dashboard h3 {
    margin: 10px 0 5px;
}

.empty-dashboard p {
    color: #71717a;
    margin: 0;
}

.quick-actions {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
}

.quick-action {
    display: block;
    padding: 18px;
    border: 1px solid #e4e4e7;
    border-radius: 13px;
    text-decoration: none;
    color: #18181b;
    transition: .2s;
}

.quick-action:hover {
    border-color: #a1a1aa;
    transform: translateY(-2px);
    color: #18181b;
}

.quick-action span {
    display: block;
    font-size: 25px;
    margin-bottom: 10px;
}

.quick-action strong {
    display: block;
    margin-bottom: 4px;
}

.quick-action small {
    color: #71717a;
}

@@media (max-width: 900px) {
    .stats-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .section-grid {
        grid-template-columns: 1fr;
    }

    .status-grid {
        grid-template-columns: repeat(3, 1fr);
    }
}

@@media (max-width: 600px) {
    .dashboard-header {
        align-items: flex-start;
        flex-direction: column;
    }

    .stats-grid {
        grid-template-columns: 1fr;
    }

    .sales-grid {
        grid-template-columns: 1fr;
    }

    .stock-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .status-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .quick-actions {
        grid-template-columns: 1fr;
    }
}
</style>