@model KidsWearStore.Models.Product

@{
    ViewData["Title"] = "Edit Product";
}

<div class="container py-5">

    <div class="mb-4">

        <a asp-action="Manage"
           class="text-decoration-none">
            ← Back to Products
        </a>

        <h1 class="fw-bold mt-3 mb-1">
             Edit Product
        </h1>

        <p class="text-muted">
            Update product information, stock and image.
        </p>

    </div>


    <div class="card shadow-sm border-0">

        <div class="card-body p-4 p-md-5">

            <form asp-action="Edit"
                  asp-route-id="@Model.Id"
                  method="post"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       asp-for="Id" />


                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger">
                </div>


                <!-- BASIC INFORMATION -->

                <h4 class="fw-bold mb-3">
                     Basic Information
                </h4>

                <div class="row g-3">

                    <div class="col-md-8">

                        <label asp-for="Name"
                               class="form-label fw-semibold">
                            Product Name
                        </label>

                        <input asp-for="Name"
                               class="form-control" />

                        <span asp-validation-for="Name"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-4">

                        <label asp-for="CategoryId"
                               class="form-label fw-semibold">
                            Category
                        </label>

                        <select asp-for="CategoryId"
                                asp-items="ViewBag.Categories"
                                class="form-select">

                            <option value="">
                                -- Select Category --
                            </option>

                        </select>

                        <span asp-validation-for="CategoryId"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-12">

                        <label asp-for="ShortDescription"
                               class="form-label fw-semibold">
                            Short Description
                        </label>

                        <input asp-for="ShortDescription"
                               class="form-control" />

                    </div>


                    <div class="col-12">

                        <label asp-for="Description"
                               class="form-label fw-semibold">
                            Full Description
                        </label>

                        <textarea asp-for="Description"
                                  class="form-control"
                                  rows="5">
                        </textarea>

                    </div>

                </div>


                <hr class="my-4" />


                <!-- PRICING -->

                <h4 class="fw-bold mb-3">
                     Pricing
                </h4>

                <div class="row g-3">

                    <div class="col-md-4">

                        <label asp-for="Price"
                               class="form-label fw-semibold">
                            Original Price (₹)
                        </label>

                        <input asp-for="Price"
                               class="form-control"
                               type="number"
                               step="0.01"
                               min="0" />

                    </div>


                    <div class="col-md-4">

                        <label asp-for="DiscountPrice"
                               class="form-label fw-semibold">
                            Discount Price (₹)
                        </label>

                        <input asp-for="DiscountPrice"
                               class="form-control"
                               type="number"
                               step="0.01"
                               min="0" />

                    </div>


                    <div class="col-md-4">

                        <label asp-for="DiscountPercentage"
                               class="form-label fw-semibold">
                            Discount (%)
                        </label>

                        <input asp-for="DiscountPercentage"
                               class="form-control"
                               type="number"
                               step="0.01"
                               min="0"
                               max="100" />

                    </div>

                </div>


                <hr class="my-4" />


                <!-- INVENTORY -->

                <h4 class="fw-bold mb-3">
                     Inventory
                </h4>

                <div class="row g-3">

                    <div class="col-md-4">

                        <label asp-for="StockQuantity"
                               class="form-label fw-semibold">
                            Stock Quantity
                        </label>

                        <input asp-for="StockQuantity"
                               class="form-control"
                               type="number"
                               min="0" />

                    </div>


                    <div class="col-md-4">

                        <label asp-for="Sizes"
                               class="form-label fw-semibold">
                            Sizes
                        </label>

                        <input asp-for="Sizes"
                               class="form-control" />

                    </div>


                    <div class="col-md-4">

                        <label asp-for="Colors"
                               class="form-label fw-semibold">
                            Colors
                        </label>

                        <input asp-for="Colors"
                               class="form-control" />

                    </div>

                </div>


                <hr class="my-4" />


                <!-- IMAGE -->

                <h4 class="fw-bold mb-3">
                     Product Image
                </h4>

                <div class="row g-4">

                    <div class="col-md-5">

                        <p class="fw-semibold mb-2">
                            Current Image
                        </p>

                        @if (!string.IsNullOrWhiteSpace(
                            Model.MainImageUrl))
                        {
                            <img src="@Model.MainImageUrl"
                                 alt="@Model.Name"
                                 class="img-fluid rounded border"
                                 style="width:100%;height:250px;object-fit:contain;" />
                        }
                        else
                        {
                            <div class="border rounded d-flex align-items-center justify-content-center"
                                 style="height:250px;background:#f8f9fa;font-size:70px;">
                                
                            </div>
                        }

                    </div>


                    <div class="col-md-7">

                        <label for="imageFile"
                               class="form-label fw-semibold">
                            Replace Product Image
                        </label>

                        <input type="file"
                               id="imageFile"
                               name="imageFile"
                               class="form-control"
                               accept=".jpg,.jpeg,.png,.webp"
                               onchange="previewImage(event)" />

                        <div class="form-text mb-3">
                            Leave empty to keep the current image.
                            JPG, JPEG, PNG or WEBP.
                            Maximum size: 5 MB.
                        </div>


                        <div id="imagePreviewContainer"
                             style="display:none;">

                            <p class="fw-semibold">
                                New Image Preview
                            </p>

                            <img id="imagePreview"
                                 src="#"
                                 alt="New Image Preview"
                                 class="img-fluid rounded border"
                                 style="width:100%;height:250px;object-fit:contain;" />

                        </div>

                    </div>

                </div>


                <hr class="my-4" />


                <!-- SETTINGS -->

                <h4 class="fw-bold mb-3">
                    ⭐ Product Settings
                </h4>

                <div class="row g-3">

                    <div class="col-md-3">

                        <div class="form-check">

                            <input asp-for="IsFeatured"
                                   class="form-check-input" />

                            <label asp-for="IsFeatured"
                                   class="form-check-label">
                                ⭐ Featured
                            </label>

                        </div>

                    </div>


                    <div class="col-md-3">

                        <div class="form-check">

                            <input asp-for="IsNewArrival"
                                   class="form-check-input" />

                            <label asp-for="IsNewArrival"
                                   class="form-check-label">
                                 New Arrival
                            </label>

                        </div>

                    </div>


                    <div class="col-md-3">

                        <div class="form-check">

                            <input asp-for="IsBestSeller"
                                   class="form-check-input" />

                            <label asp-for="IsBestSeller"
                                   class="form-check-label">
                                 Best Seller
                            </label>

                        </div>

                    </div>


                    <div class="col-md-3">

                        <div class="form-check">

                            <input asp-for="IsActive"
                                   class="form-check-input" />

                            <label asp-for="IsActive"
                                   class="form-check-label">
                                 Active
                            </label>

                        </div>

                    </div>

                </div>


                <!-- BUTTONS -->

                <div class="d-flex gap-2 mt-5">

                    <button type="submit"
                            class="btn btn-primary px-4">
                         Update Product
                    </button>

                    <a asp-action="Manage"
                       class="btn btn-outline-secondary px-4">
                        Cancel
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }


    <script>

        function previewImage(event) {

            const file =
                event.target.files[0];

            const preview =
                document.getElementById(
                    "imagePreview");

            const container =
                document.getElementById(
                    "imagePreviewContainer");


            if (file) {

                const reader =
                    new FileReader();

                reader.onload =
                    function (e) {

                        preview.src =
                            e.target.result;

                        container.style.display =
                            "block";
                    };

                reader.readAsDataURL(file);

            }
            else {

                container.style.display =
                    "none";

                preview.src = "#";
            }
        }

    </script>
}