@model IEnumerable<KidsWearStore.Models.ApplicationUser>

@{
    ViewData["Title"] = "Admin · Product Managers";
    var managerCount = (int)(ViewBag.ProductManagerCount ?? 0);
    var maxManagers = (int)(ViewBag.MaxProductManagers ?? 4);

    var userRoles =
        ViewBag.UserRoles as
        Dictionary<string, IList<string>>
        ?? new Dictionary<string, IList<string>>();
}

<div class="admin-page">

    <div class="admin-header">

        <div>
            <span class="admin-badge">ADMIN PANEL</span>

            <h1>Admin Dashboard</h1>

            <p>Manage store access and appoint up to 4 Product Managers.</p>
        </div>

        <a asp-controller="Home"
           asp-action="Index"
           class="admin-back">
            <i class="bi bi-arrow-left me-1"></i> Back to Store
        </a>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="admin-alert success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="admin-alert error">
            @TempData["Error"]
        </div>
    }

    <div class="admin-stats">

        <div class="admin-stat-card">
            <span></span>
            <strong>@Model.Count()</strong>
            <small>Total Users</small>
        </div>

        <div class="admin-stat-card">
            <span></span>
            <strong>
                @Model.Count(u =>
                    userRoles.ContainsKey(u.Id) &&
                    userRoles[u.Id].Contains("ProductManager"))
            </strong>
            <small>Product Managers</small>
        </div>

        <div class="admin-stat-card">
            <span></span>
            <strong>
                @Model.Count(u =>
                    userRoles.ContainsKey(u.Id) &&
                    userRoles[u.Id].Contains("Customer"))
            </strong>
            <small>Customers</small>
        </div>

    </div>

    <div class="admin-card">

        <div class="admin-card-header d-flex justify-content-between align-items-start gap-3 flex-wrap">
            <div>
                <h2>User Management</h2>
                <p>Assign or remove Product Manager access. Customers cannot choose this role during registration.</p>
            </div>
            <div class="manager-capacity">
                <strong>@managerCount / @maxManagers</strong>
                <span>Product Manager seats</span>
            </div>
        </div>

        <div class="admin-table-wrapper">

            <table class="admin-table">

                <thead>
                    <tr>
                        <th>User</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Created</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>

                @foreach (var user in Model)
                {
                    var roles =
                        userRoles.ContainsKey(user.Id)
                            ? userRoles[user.Id]
                            : new List<string>();

                    <tr>

                        <td>
                            <div class="user-cell">
                                <div class="user-avatar">
                                    @user.FirstName.FirstOrDefault()
                                </div>

                                <div>
                                    <strong>
                                        @user.FirstName @user.LastName
                                    </strong>
                                </div>
                            </div>
                        </td>

                        <td>
                            @user.Email
                        </td>

                        <td>
                            @foreach (var role in roles)
                            {
                                <span class="role-badge @role.ToLower()">
                                    @role
                                </span>
                            }
                        </td>

                        <td>
                            @user.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")
                        </td>

                        <td>

                            @if (roles.Contains("Admin"))
                            {
                                <span class="protected-label">
                                     Protected
                                </span>
                            }
                            else if (roles.Contains("ProductManager"))
                            {
                                <form asp-action="RemoveProductManager"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="userId"
                                           value="@user.Id" />

                                    <button type="submit"
                                            class="admin-action remove">
                                        Remove Manager
                                    </button>

                                </form>
                            }
                            else
                            {
                                <form asp-action="AssignProductManager"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="userId"
                                           value="@user.Id" />

                                    <button type="submit"
                                            class="admin-action assign"
                                            @(managerCount >= maxManagers ? "disabled" : null)>
                                        @(managerCount >= maxManagers ? "Manager limit reached" : "Appoint Product Manager")
                                    </button>

                                </form>
                            }

                        </td>

                    </tr>
                }

                </tbody>

            </table>

        </div>

    </div>

</div>
<style>
.manager-capacity{display:flex;align-items:center;gap:9px;background:#f8f6f7;border:1px solid #ece8eb;border-radius:10px;padding:9px 12px}.manager-capacity strong{font-size:13px}.manager-capacity span{font-size:10px;color:#77727a}.admin-action:disabled{opacity:.45;cursor:not-allowed}.admin-stat-card span i{font-size:21px}
</style>
